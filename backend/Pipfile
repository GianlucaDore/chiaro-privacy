[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "~=0.141.0"

#             Gli "extras" fra parentesi quadre sono pacchetti opzionali che
#             uvicorn si porta dietro solo se glieli chiedi: "standard" include
#             il reload automatico e i websocket. Quella parte non si tocca.
uvicorn = {extras = ["standard"], version = "~=0.52.4"}
pydantic = "~=2.13"
pydantic-settings = "==2.15.0"

[dev-packages]
# --- Strumenti che servono mentre si sviluppa, non all'app in produzione ---
# Restano fuori dall'immagine Docker finale: l'app in produzione
# non deve trasportare un motore di test che non eseguirà mai.

pytest = "==9.1.1"

#              httpx Non è nella scaletta, ma il `TestClient` di FastAPI lo usa
#              internamente per fingere di fare richieste all'app senza avviare
#              un server vero. Senza httpx i test del passo 1.7 non partono.
httpx = "~=0.28.1"
ruff = "~=0.16.6"

#              pyright: controllore di tipi.
pyright = "==1.1.411"

[scripts]
# --- Scorciatoie: `pipenv run <nome>` esegue il comando corrispondente ---

# `uvicorn main:app` significa: nel file `main.py` cerca la
#              variabile chiamata `app`. Ma `main.py` non sta nella cartella
#              `backend/`, sta in `backend/app/main.py`, quindi il nome del
#              modulo da scrivere non è `main` ma `app.main`.
dev = "uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload"
prod = "uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4"

#           `pytest tests/` esegue TUTTI i tests nella folder `tests/`
test = "pytest tests/"
ruff = "ruff check"
pyright = "pyright app/"

[requires]
python_version = "3.12"
