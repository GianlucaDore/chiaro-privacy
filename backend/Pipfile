[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# TODO(0.4/1) Aggiorna la versione. Oggi è ferma alla 0.111.0, di metà 2024;
#             l'ultima pubblicata è la 0.141.1.
fastapi = "==0.141.0"

# TODO(0.4/2) Aggiorna la versione: dalla 0.29.0 alla 0.52.4.
#             Gli "extras" fra parentesi quadre sono pacchetti opzionali che
#             uvicorn si porta dietro solo se glieli chiedi: "standard" include
#             il reload automatico e i websocket. Quella parte non si tocca.
uvicorn = {extras = ["standard"], version = "==0.29.0"}

# TODO(0.4/3) Aggiorna la versione: dalla 2.7.1 alla 2.13.5.
pydantic = "==2.7.1"

# TODO(0.4/4) AGGIUNGI QUI il pacchetto `pydantic-settings` (ultima: 2.15.0).
#             ⚠️ Senza questo il backend non parte affatto: app/core/config.py
#             alla riga 6 fa `from pydantic_settings import BaseSettings`, e
#             quel modulo non è installato. È il buco più grave del template.

# TODO(0.4/5) CANCELLA le due righe qui sotto, entrambe.
#             Servivano per firmare e verificare token JWT, ma l'autenticazione
#             di questo progetto (fase 2) è "stateful": una tabella `sessions`
#             sul database e un cookie. Nessun JWT, quindi nessuno dei due serve.
pyjwt = "==2.10.1"
cryptography = "==44.0.2"

