[scripts]
# --- Scorciatoie: `pipenv run <nome>` esegue il comando corrispondente ---

# TODO(0.4/10) Correggi il percorso del modulo in ENTRAMBE le righe qui sotto.
#              `uvicorn main:app` significa: nel file `main.py` cerca la
#              variabile chiamata `app`. Ma `main.py` non sta nella cartella
#              `backend/`, sta in `backend/app/main.py`, quindi il nome del
#              modulo da scrivere non è `main` ma `app.main`.
#              Provalo ora, prima di correggerlo: l'errore che ottieni è
#              esattamente quello che il criterio del passo ti chiede di far
#              sparire.
dev = "uvicorn main:app --host 127.0.0.1 --port 8000 --reload"
prod = "uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4"

# TODO(0.4/11) AGGIUNGI tre scorciatoie tue, una per ogni strumento nuovo:
#              - una per lanciare i test con pytest
#              - una per lanciare il controllo di ruff
#              - una per lanciare il controllo dei tipi con pyright
#              I nomi li scegli tu; suggerimento: che siano corti e ovvi,
#              perché li scriverai centinaia di volte.

[requires]
# TODO(0.4/12) DECIDI la versione e scrivila qui. Le due opzioni sono entrambe
#              valide e hanno costi diversi.
#
#              ⚠️ CORREZIONE di quanto ti avevo detto prima: la 3.11 C'È.
#              Mi ero basato su `py -0`, che elenca solo gli interpreti
#              registrati in Windows, mentre pyenv tiene i propri fuori da quel
#              registro. La situazione reale è questa:
#                - pyenv ha installate 3.10.11, 3.11.7 e 3.11.9
#                - il file `.python-version` di questa cartella chiede 3.11.7,
#                  e quella versione c'è: nessun disallineamento
#                - la 3.12.1 e la 3.13 esistono, ma FUORI da pyenv
#
#              Opzione A - lasciare "3.11": funziona subito, senza toccare
#              nulla, e `.python-version` resta com'è.
#              Opzione B - mettere "3.12": più moderna, ma costa un passaggio
#              in più, `pyenv install 3.12.x`, e l'allineamento di
#              `.python-version`. Senza quel passaggio pyenv non trova la
#              versione richiesta e `python`, in questa cartella, smette di
#              rispondere.
#
#              ⚠️ `.python-version` non può contenere commenti, quindi il
#              cartello che lo riguarda sta qui.
python_version = "3.11"
