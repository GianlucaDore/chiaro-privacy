# Le variabili d'ambiente che il backend legge all'avvio, con valori adatti allo sviluppo.
# Copia questo file in .env, nella stessa cartella: il .env resta fuori dal repository.

# OBBLIGATORIE
# Se ne manca una, l'app non parte e all'avvio dice quale.

# Environment da utilizzare per avviare il progetto. Ammessi: "DEV", "TEST", "PROD".
ENV=DEV

# FACOLTATIVE

# Le origini da cui il browser può chiamare l'API: una sola, o più separate da virgole.
# Se manca, non si registra nessuna regola CORS e il browser blocca le chiamate del
# frontend. Il valore qui sotto è quello del dev server di Vite (npm run dev).
BACKEND_CORS_ORIGIN=http://localhost:5173
